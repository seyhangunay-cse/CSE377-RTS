{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RTSActionPlan",
    "type": "object",
    "required": [
        "summary",
        "confidence",
        "actions"
    ],
    "properties": {
        "summary": {
            "type": "string",
            "maxLength": 400
        },
        "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "actions": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "type": "object",
                "required": [
                    "action_type",
                    "reason"
                ],
                "properties": {
                    "action_type": {
                        "type": "string",
                        "enum": [
                            "TRAIN_UNIT",
                            "BUILD",
                            "MOVE_GROUP",
                            "RESEARCH",
                            "SCOUT",
                            "EXPLORE",
                            "ATTACK",
                            "ATTACK_MOVE"
                        ]
                    },
                    "unit_type": {
                        "type": "string"
                    },
                    "building_type": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                    },
                    "target_zone": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string",
                        "maxLength": 250
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}